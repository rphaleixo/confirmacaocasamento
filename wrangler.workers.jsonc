// Configuração para rodar no Cloudflare Workers (com arquivos estáticos). Convive com o wrangler.toml (Pages) até a troca de endereço.
// Gerar o código das rotas: npx wrangler@4 pages functions build --outdir=.build/_worker.js
// Publicar:                 npx wrangler@4 deploy -c wrangler.workers.jsonc
{
  "name": "vemnafesta",
  "main": ".build/_worker.js/index.js",
  // O próprio deploy gera o código das rotas e monta a pasta .public (só o que é público) antes de publicar (não depende de preencher o "Build command" na Cloudflare).
  "build": { "command": "npx wrangler@4 pages functions build --outdir=.build/_worker.js && node ferramentas/montar-site.mjs" },
  "compatibility_date": "2026-09-05",
  // run_worker_first: nestas páginas o Worker olha o endereço antes de entregar o arquivo (é assim que nome.vemnafesta.com mostra o convite de "nome")
  "assets": { "directory": ".public", "binding": "ASSETS", "run_worker_first": ["/", "/admin", "/admin/", "/presentes", "/presentes/", "/preview", "/preview/", "/teste", "/teste/", "/exemplo", "/exemplo/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "confirmacaocasamento", "database_id": "0ece6983-d130-4724-841c-18288f1ddaa1" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "confirmacaocasamento-media" }
  ],
  // Domínio próprio: vemnafesta.com (apex) como Custom Domain e todos os subdomínios (um por evento) por uma rota com curinga.
  // Requer o registro DNS * (AAAA 100:: com proxy ligado) no domínio.
  // Mantém também o endereço de testes vemnafesta.aleixo.workers.dev (por padrão o Wrangler o desliga quando há domínio próprio).
  "workers_dev": true,
  "routes": [
    { "pattern": "vemnafesta.com", "custom_domain": true },
    { "pattern": "*.vemnafesta.com/*", "zone_name": "vemnafesta.com" }
  ],
  "observability": { "enabled": true }
}
